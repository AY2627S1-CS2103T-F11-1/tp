@startuml
!include style.puml
skinparam ArrowFontStyle plain
box Model MODEL_COLOR_T1
participant ":ModelManager" as MM MODEL_COLOR
participant ":VersionedAddressBook" as Book MODEL_COLOR
end box
[-> MM : undoAddressBook()
activate MM
MM -> Book : undo()
activate Book
