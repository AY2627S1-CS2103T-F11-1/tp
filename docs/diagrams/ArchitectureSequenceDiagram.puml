@startuml
!include style.puml
skinparam ArrowFontStyle plain
actor User as User USER_COLOR
participant ":Ui" as Ui UI_COLOR
participant ":Logic" as Logic LOGIC_COLOR
participant ":Model" as Model MODEL_COLOR
participant ":Storage" as Storage STORAGE_COLOR

User -> Ui : "delete 1"
activate Ui
Ui -> Logic : execute("delete 1")
activate Logic
Logic -> Model : getFilteredPersonList()
activate Model
Model --> Logic : displayed contacts
deactivate Model
note over Logic
  Parsing and index validation succeed;
  p is the contact at displayed index 1.
end note
Logic -> Model : deletePerson(p)
activate Model
Model --> Logic
deactivate Model
Logic -> Model : commitAddressBook()
activate Model
Model --> Logic
deactivate Model
Logic -> Model : getAddressBook()
activate Model
Model --> Logic : addressBook
deactivate Model
Logic -> Storage : saveAddressBook(addressBook)
activate Storage
Storage --> Logic : saved
deactivate Storage
Logic --> Ui : CommandResult
deactivate Logic
Ui -> Ui : reconcile selection and display feedback
Ui --> User : updated contact list
deactivate Ui
@enduml
