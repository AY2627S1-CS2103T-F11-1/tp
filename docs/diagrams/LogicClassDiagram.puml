@startuml
!include style.puml
!pragma layout smetana
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package Logic as LogicPackage {
interface Logic <<interface>>
class LogicManager
class AddressBookParser
abstract class Command
class XYZCommand
class CommandResult
class CommandSelectionChange
}
interface Model <<interface>> MODEL_COLOR
interface Storage <<interface>> STORAGE_COLOR

LogicManager ..|> Logic
LogicManager --> "1" AddressBookParser
AddressBookParser ..> Command : returns
XYZCommand --|> Command
LogicManager ..> Command : executes
Command ..> Model : updates or queries
Command ..> CommandResult : creates
LogicManager --> "1" Model
LogicManager --> "1" Storage
LogicManager --> "1" CommandSelectionChange
CommandSelectionChange ..> Model : refers to contacts
Logic ..> CommandResult
Logic ..> CommandSelectionChange

@enduml
