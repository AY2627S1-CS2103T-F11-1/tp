@startuml
skin rose
skinparam ActivityFontSize 15
skinparam ArrowFontSize 12
start
:Validate help arguments;
if (More than one argument?) then (yes)
    :Report ParseException;
    stop
else (no)
endif
if (Command name supplied?) then (yes)
    if (Supported command?) then (yes)
        :Create usage feedback
with showHelp = false;
    else (no)
        :Create guidance feedback
with showHelp = false;
    endif
else (no)
    :Create opening feedback
with showHelp = true;
endif
:LogicManager requests a contact-data save;
if (Save succeeds?) then (yes)
    :Display feedback in ResultDisplay;
else (no)
    :Report CommandException;
    stop
endif
if (showHelp?) then (yes)
    :Open or focus HelpWindow;
else (no)
endif
stop
@enduml
