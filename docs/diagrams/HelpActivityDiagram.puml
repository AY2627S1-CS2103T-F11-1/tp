@startuml
skin rose
skinparam ActivityFontSize 15
skinparam ArrowFontSize 12

start
:Parse help input;

if () then ([No command specified])
    :Create CommandResult with opening feedback\nand showHelp = true;
else ([Command specified])
    if () then ([Command supported])
        :Look up the target command's COMMAND_USAGE;
        :Create CommandResult with usage feedback\nand showHelp = false;
    else ([Command unsupported])
        :Create CommandResult with guidance\nand showHelp = false;
    endif
endif

:Display feedback in ResultDisplay;

'Use a two-case layout to separate the guards on the left and right paths.
switch ()
case ([Help window requested])
    :Open or focus HelpWindow;
case ([Help window not requested])
endswitch

stop
@enduml
