@startuml
!include style.puml
skinparam ArrowFontStyle plain
box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LM LOGIC_COLOR
participant ":AddressBookParser" as ABP LOGIC_COLOR
participant ":UndoCommandParser" as Parser LOGIC_COLOR
participant "u:UndoCommand" as Undo LOGIC_COLOR
end box
box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LM : execute("undo")
activate LM
LM -> ABP : parseCommand("undo")
activate ABP
create Parser
ABP -> Parser
ABP -> Parser : parse("")
activate Parser
create Undo
Parser -> Undo
Parser --> ABP : u
deactivate Parser
ABP --> LM : u
deactivate ABP
LM -> Undo : execute(m)
activate Undo
Undo -> Model : canUndoAddressBook()
activate Model
Model --> Undo : true
deactivate Model
Undo -> Model : undoAddressBook()
activate Model
Model --> Undo
deactivate Model
Undo --> LM : CommandResult("Undo success!")
deactivate Undo
[<-- LM : result
deactivate LM
@enduml
