@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":FollowUpCommandParser" as FollowUpCommandParser LOGIC_COLOR
participant "f:SetFollowUpCommand" as SetFollowUpCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("followup ...")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand(input)
activate AddressBookParser

create FollowUpCommandParser
AddressBookParser -> FollowUpCommandParser
activate FollowUpCommandParser

FollowUpCommandParser --> AddressBookParser
deactivate FollowUpCommandParser

AddressBookParser -> FollowUpCommandParser : parse(arguments)
activate FollowUpCommandParser

create SetFollowUpCommand
FollowUpCommandParser -> SetFollowUpCommand
activate SetFollowUpCommand

SetFollowUpCommand --> FollowUpCommandParser : f
deactivate SetFollowUpCommand

FollowUpCommandParser --> AddressBookParser : f
deactivate FollowUpCommandParser

AddressBookParser --> LogicManager : f
deactivate AddressBookParser

LogicManager -> SetFollowUpCommand : execute(m)
activate SetFollowUpCommand

SetFollowUpCommand -> Model : getFilteredPersonList()
activate Model

Model --> SetFollowUpCommand : lastShownList
deactivate Model


SetFollowUpCommand -> Model : setPerson(oldPerson, updatedPerson)
activate Model

Model --> SetFollowUpCommand
deactivate Model

SetFollowUpCommand -> Model : commitAddressBook()
activate Model

Model --> SetFollowUpCommand
deactivate Model


SetFollowUpCommand --> LogicManager : result
deactivate SetFollowUpCommand

[<--LogicManager : result
deactivate LogicManager
@enduml
