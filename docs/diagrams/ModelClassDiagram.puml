@startuml
!include style.puml
!pragma layout smetana
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

package Model as ModelPackage {
interface Model <<interface>>
interface ReadOnlyAddressBook <<interface>>
interface ReadOnlyUserPrefs <<interface>>
class ModelManager
class VersionedAddressBook
class AddressBook
class UserPrefs
class UniquePersonList
class Person
class Name
class Phone
class Email
class Address
class Role
class FollowUp
class Tag
}

ModelManager ..|> Model
ModelManager --> "1" VersionedAddressBook : addressBook
ModelManager --> "1" UserPrefs : userPrefs
UserPrefs ..|> ReadOnlyUserPrefs
VersionedAddressBook --|> AddressBook
AddressBook ..|> ReadOnlyAddressBook
AddressBook *--> "1" UniquePersonList
UniquePersonList --> "0..*" Person
Person --> "1" Name
Person --> "1" Phone
Person --> "1" Email
Person --> "1" Address
Person --> "1" Role
Person --> "0..1" FollowUp
Person --> "0..*" Tag

@enduml
