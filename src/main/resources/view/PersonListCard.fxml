<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" minWidth="0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="ALWAYS" minWidth="0" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" spacing="3" minWidth="0" GridPane.columnIndex="0">
      <padding>
        <Insets top="8" right="12" bottom="8" left="12" />
      </padding>
      <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="id" styleClass="cell_big_label">
          <minWidth>
            <!-- Ensures that the label text is never truncated -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
        <Label fx:id="name" styleClass="cell_big_label" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
        <Label fx:id="role" styleClass="role-badge" wrapText="true" minWidth="0"
               minHeight="-Infinity" />
      </HBox>
      <Label fx:id="phone" styleClass="cell_small_label" wrapText="true" minWidth="0"
             minHeight="-Infinity" maxWidth="Infinity" />
      <FlowPane fx:id="tags" minWidth="0">
        <padding>
          <Insets top="6" bottom="6" />
        </padding>
      </FlowPane>
    </VBox>
  </GridPane>
</HBox>
