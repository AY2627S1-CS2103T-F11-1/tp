<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root resizable="false" title="Help" type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <VBox fx:id="helpMessageContainer" spacing="12.0" prefWidth="820.0" prefHeight="560.0">
        <children>
          <Label text="Available commands" styleClass="help-heading" />
          <TextArea fx:id="helpMessage" editable="false" focusTraversable="false" wrapText="true"
                    prefRowCount="20" VBox.vgrow="ALWAYS" />
          <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
              <Label styleClass="footer-label" text="For more detailed information:" />
              <Hyperlink fx:id="userGuideLink" onAction="#openUserGuide" text="User guide" />
              <Button fx:id="copyButton" mnemonicParsing="false" onAction="#copyUrl" text="Copy URL" />
            </children>
          </HBox>
        </children>
        <padding>
          <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
        </padding>
      </VBox>
    </Scene>
  </scene>
</fx:root>
